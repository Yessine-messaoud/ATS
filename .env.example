# Copy to .env (git-ignored). Read by docker-compose.
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=<set-a-local-password>

# LLM used for extraction, explanations and the assistant.
#   ollama    - local model served by Ollama (default; free, CVs stay on this machine). Needs a model with tool
#               support for the assistant: `ollama pull mistral` (also: llama3.1, qwen2.5). Inference runs on the
#               host GPU; the backend container reaches it through host.docker.internal.
#   anthropic - Claude (more accurate and faster; needs ANTHROPIC_API_KEY from https://platform.claude.com).
LLM_PROVIDER=ollama
OLLAMA_MODEL=mistral
ANTHROPIC_API_KEY=

# Encryption at rest for uploaded documents (required when APP_ENV=production).
# Generate: cd backend && uv run python -m app.security.crypto. Rotation: "new,old", then scripts.encrypt_documents.
DOCUMENT_ENCRYPTION_KEYS=
