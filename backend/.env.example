APP_NAME=ATS Recruitment API
APP_ENV=development
DEBUG=true

# Must match the POSTGRES_* values used by docker-compose (see ../.env.example)
DATABASE_URL=postgresql+psycopg://ats_user:<same-password-as-root-.env>@localhost:5432/ats_db
CORS_ORIGINS=["http://localhost:3000"]

# LLM provider: "ollama" (local, default) or "anthropic" (Claude; needs ANTHROPIC_API_KEY or `ant auth login`).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# GPU layers; 99 keeps the whole model on the GPU (fits a 7B Q4 model with an 8k context on a 6 GB card).
OLLAMA_NUM_GPU=99
OLLAMA_NUM_CTX=8192
ANTHROPIC_API_KEY=
